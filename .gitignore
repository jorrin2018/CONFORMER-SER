# ---------------------------------------------------------------------------
# CONFORMER-SER — .gitignore
# Versionado: código (src/, scripts/, config/), documentación (docs/, paper/)
# Ignorado: entornos, cachés, datos, checkpoints y salidas de experimentos.
# ---------------------------------------------------------------------------

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Entornos virtuales ----------------------------------------------------
env/
ENV/
venv/
.venv/

# --- Node (solo herramienta de diagramas: mermaid-cli) ---------------------
node_modules/

# --- Cachés ----------------------------------------------------------------
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
transformers_cache/

# --- Pesos de modelos ------------------------------------------------------
*.pt
*.pth
*.ckpt
*.safetensors

# --- Entrenamiento: logs, checkpoints y trazas -----------------------------
logs/
checkpoints/
runs/
wandb/
*.log
events.out.tfevents.*

# --- Resultados de evaluación ----------------------------------------------
evaluation_results/
results/
outputs/

# --- Datos -----------------------------------------------------------------
data/
datasets/
*.wav
*.mp3
*.flac

# --- Notebooks -------------------------------------------------------------
.ipynb_checkpoints
*.ipynb_checkpoints

# --- Herramientas de edición (config local, no del proyecto) ---------------
.vscode/
.idea/
.cursor/
.obsidian/
*.swp
*.swo
*~

# --- Sistema operativo -----------------------------------------------------
.DS_Store
Thumbs.db

# --- Planes de cambio locales (OpenSpec) -----------------------------------
openspec/

# --- Temporales y scratch --------------------------------------------------
tmp/
temp/
*.tmp
script.py
debug_*.py
check_*.py
