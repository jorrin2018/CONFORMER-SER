        <mxCell id="out_sf" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size:10px&quot;&gt;4-class Softmax&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#404040;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1605" y="430" width="210" height="40" as="geometry" />
        </mxCell>
        <mxCell id="out_lbl" value="&lt;div style=&quot;font-family:Times New Roman;font-size:11px;text-align:center&quot;&gt;&lt;b&gt;😠&lt;/b&gt; Angry &lt;b&gt;😊&lt;/b&gt; Happy &lt;b&gt;😢&lt;/b&gt; Sad &lt;b&gt;😐&lt;/b&gt; Neutral&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1560" y="486" width="300" height="46" as="geometry" />
        </mxCell>

        <mxCell id="e_out1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="mst_lin" target="out_sf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_out2" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="out_sf" target="out_lbl"><mxGeometry relative="1" as="geometry" /></mxCell>

