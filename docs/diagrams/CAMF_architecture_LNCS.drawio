          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Stacked X^(0) → cross-stream block (dashed) -->
        <mxCell id="stack_x0" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;dashed=1;html=1;" edge="1" parent="1" source="b1_5" target="fus_xatt">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1045" y="131" /><mxPoint x="1045" y="486" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="stack_x1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;dashed=1;html=1;" edge="1" parent="1" source="b2_5" target="fus_xatt">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="337" /><mxPoint x="1015" y="486" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="stack_x2" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;dashed=1;html=1;" edge="1" parent="1" source="b3_5" target="fus_xatt">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="575" /><mxPoint x="980" y="486" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="lbl_stack" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size:7px&quot;&gt;solid: to unimodal logits;&lt;br&gt;dashed: rows of &lt;b&gt;X&lt;/b&gt;&lt;sup&gt;(0)&lt;/sup&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#333333;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="900" y="8" width="150" height="36" as="geometry" />
        </mxCell>

        <!-- MST Head -->
        <mxCell id="mst_bg" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size:11px&quot;&gt;&lt;b&gt;MultiScaleTemporal Head&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#555555;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontFamily=Times New Roman;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1540" y="162" width="340" height="300" as="geometry" />
        </mxCell>

        <mxCell id="mst_p1" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size:8px&quot;&gt;Mean+Max+Attn Pool&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size:7px&quot;&gt;→ &lt;b&gt;h&lt;/b&gt;&lt;sub&gt;pool&lt;/sub&gt; ∈ ℝ&lt;sup&gt;1536&lt;/sup&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#666666;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1555" y="205" width="100" height="56" as="geometry" />
        </mxCell>
        <mxCell id="mst_p2" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size:8px&quot;&gt;2-layer BiLSTM&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size:7px&quot;&gt;→ &lt;b&gt;h&lt;/b&gt;&lt;sub&gt;lstm&lt;/sub&gt; ∈ ℝ&lt;sup&gt;512&lt;/sup&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#666666;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1665" y="205" width="100" height="56" as="geometry" />
        </mxCell>
        <mxCell id="mst_p3" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size:8px&quot;&gt;4-head Self-Attn&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size:7px&quot;&gt;→ &lt;b&gt;h&lt;/b&gt;&lt;sub&gt;sa&lt;/sub&gt; ∈ ℝ&lt;sup&gt;512&lt;/sup&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#666666;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1775" y="205" width="100" height="56" as="geometry" />
        </mxCell>

        <mxCell id="mst_cat" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size:9px&quot;&gt;Concat &lt;b&gt;h&lt;/b&gt;&lt;sub&gt;MST&lt;/sub&gt; ∈ ℝ&lt;sup&gt;2560&lt;/sup&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dddddd;strokeColor=#555555;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1565" y="288" width="290" height="36" as="geometry" />
        </mxCell>
        <mxCell id="mst_do" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size:9px&quot;&gt;Dropout(0.4)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1645" y="338" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mst_lin" value="&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size:9px&quot;&gt;Linear (2560→4)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#666666;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="1645" y="378" width="130" height="30" as="geometry" />
        </mxCell>

        <mxCell id="em1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="mst_p1" target="mst_cat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="em2" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="mst_p2" target="mst_cat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="em3" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="mst_p3" target="mst_cat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="em4" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="mst_cat" target="mst_do"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="em5" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="mst_do" target="mst_lin"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- fusion to MST -->
        <mxCell id="e_fus_mst" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1.5;strokeColor=#000000;html=1;" edge="1" parent="1" source="fus_agg" target="mst_bg">
          <mxGeometry relative="1" as="geometry" />
