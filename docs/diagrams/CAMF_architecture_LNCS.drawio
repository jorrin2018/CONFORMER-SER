        <mxCell id="fi2" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="fus_lm" target="fus_gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fi3" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="fus_lt" target="fus_gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fi4" style="endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fus_gate" target="fus_c0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fi5" style="endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fus_gate" target="fus_c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fi6" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="fus_c0" target="fus_w"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fi7" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="fus_c1" target="fus_w"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fi8" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="fus_w" target="fus_xatt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fi9" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="fus_xatt" target="fus_agg"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- a,m,t → unimodal logits (solid) -->
        <mxCell id="in_fus_la" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="b1_5" target="fus_la">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="in_fus_lm" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeWidth=1;strokeColor=#000000;html=1;" edge="1" parent="1" source="b2_5" target="fus_lm">
          <mxGeometry relative="1" as="geometry" />
